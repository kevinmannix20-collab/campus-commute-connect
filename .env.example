# Google Maps (address autocomplete, geocoding, and the request-flow map).
# See the "Google Maps setup" section of README.md for how to create this key.
# Local dev: VITE_GOOGLE_MAPS_API_KEY (below). On Lovable's own deployment,
# set APP_GOOGLE_MAPS_API_KEY in Lovable Secrets instead — Lovable rejects
# VITE_-prefixed secret names (same issue as the Supabase keys).
VITE_GOOGLE_MAPS_API_KEY=

# Supabase overrides — only needed if you're pointing at a different project
# than the one hardcoded in src/integrations/supabase/config.ts.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
